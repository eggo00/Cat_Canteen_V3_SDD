# ===================================
# Cat Canteen Frontend - Environment Variables
# ===================================
# Copy this file to .env and update with your actual values
# NEVER commit .env to Git!

# ===================================
# API Configuration
# ===================================
VITE_API_BASE_URL=http://localhost:8000/v1

# ===================================
# Application Configuration
# ===================================
VITE_APP_NAME=Cat Canteen
VITE_APP_DESCRIPTION=可白牌化智慧餐飲訂單系統平台

# ===================================
# Feature Flags (Optional)
# ===================================
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_AI_RECOMMENDATIONS=false

# ===================================
# Analytics (Optional - Future Use)
# ===================================
# VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X
# VITE_SENTRY_DSN=https://your_sentry_dsn_here

# ===================================
# External Services (Optional - Future Use)
# ===================================
# VITE_IMAGE_CDN_BASE_URL=https://cdn.example.com
