# ===================================
# Cat Canteen V3 - .dockerignore
# ===================================
# 避免將不必要的檔案打包進 Docker Image

# Git
.git/
.gitignore
.gitattributes

# Documentation
README.md
CLAUDE.md
specs/
*.md

# IDE
.vscode/
.idea/
*.sublime-*

# OS files
.DS_Store
Thumbs.db

# Environment files (should use build args instead)
.env
.env.*
*.env

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build artifacts (we'll build fresh in container)
dist/
build/
.next/
out/

# Testing
coverage/
.coverage
*.cover

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Database files (local dev only)
*.db
*.sqlite
*.sqlite3

# Docker
docker-compose*.yml
Dockerfile*
.dockerignore
