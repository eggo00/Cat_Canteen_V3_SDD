{
  "$schema": "https://json.schemastore.org/zeabur",
  "build": {
    "type": "dockerfile",
    "dockerfile": "Dockerfile"
  },
  "start": {
    "command": "uvicorn src.api.main:app --host 0.0.0.0 --port 8080"
  },
  "healthcheck": {
    "path": "/health",
    "port": 8080
  },
  "expose": {
    "port": 8080
  }
}
