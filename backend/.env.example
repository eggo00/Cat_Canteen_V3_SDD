# ===================================
# Cat Canteen Backend - Environment Variables
# ===================================
# Copy this file to .env and update with your actual values
# NEVER commit .env to Git!

# ===================================
# Database Configuration
# ===================================
DATABASE_URL=postgresql://catcanteen:your_password_here@localhost:5432/catcanteen

# ===================================
# JWT Authentication
# ===================================
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===================================
# CORS Configuration
# ===================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.zeabur.app

# ===================================
# Application Configuration
# ===================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ===================================
# API Rate Limiting
# ===================================
RATE_LIMIT_PUBLIC=100  # requests per minute for public endpoints
RATE_LIMIT_AUTHENTICATED=1000  # requests per minute for authenticated users

# ===================================
# File Upload Configuration
# ===================================
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ===================================
# Email Configuration (Optional - Future Use)
# ===================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_app_password
# EMAIL_FROM=noreply@catcanteen.app

# ===================================
# External Services (Optional - Future Use)
# ===================================
# REDIS_URL=redis://localhost:6379/0
# SENTRY_DSN=https://your_sentry_dsn_here
